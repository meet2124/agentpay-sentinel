# =============================================================================
# AgentPay Sentinel — Environment Configuration
# =============================================================================
# Copy this file to backend/.env and populate values for your environment.
# NEVER commit a populated .env file — it is listed in .gitignore.
#
# Local development: set USE_LOCAL_ADAPTERS=True (default). No AWS needed.
# AWS deployment:    set USE_LOCAL_ADAPTERS=False and fill in all AWS values.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=local
# Options: local | staging | production
# Controls log format (JSON on AWS, plain text locally)

DEBUG=False

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Add your API Gateway URL here when deploying:
# ALLOWED_ORIGINS=https://your-api-id.execute-api.ap-south-1.amazonaws.com,http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
AUTH_MODE=api_key
# api_key: demo keys (sk-dev-basic, sk-dev-standard, sk-dev-premium, sk-test-abc123)
# cognito: planned for Phase 3.3

API_KEY_SALT=sentinel-dev-salt
# IMPORTANT: Override with a strong random value in staging/production.
# Example: python -c "import secrets; print(secrets.token_hex(32))"

SESSION_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Adapters
# ---------------------------------------------------------------------------
USE_LOCAL_ADAPTERS=True
# True  → in-memory stubs, no AWS credentials required (local/test)
# False → real AWS adapters (S3, DynamoDB) — requires IAM permissions

# ---------------------------------------------------------------------------
# AWS (required only when USE_LOCAL_ADAPTERS=False)
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1

# S3 bucket for evidence files (private, SSE-AES256)
# Created by SAM template: sentinel-evidence-{account_id}-{region}
S3_BUCKET_NAME=

# DynamoDB audit events table (sentinel-audit)
DYNAMODB_TABLE_AUDIT=sentinel-audit

# DynamoDB sessions/state/evidence table (sentinel-sessions)
# Evidence metadata is stored here using EVIDENCE# key prefix (2-table design)
DYNAMODB_TABLE_SESSIONS=sentinel-sessions

# ---------------------------------------------------------------------------
# LLM / Bedrock (Phase 3.2 — real intent + evidence extraction)
# ---------------------------------------------------------------------------
# Used when USE_LOCAL_ADAPTERS=False.
# Requires Bedrock model access to be enabled in the AWS console for your region.
# https://console.aws.amazon.com/bedrock/home#/modelaccess
#
# In ap-south-1, Claude 3.5 Sonnet v2 requires the APAC cross-region inference
# profile (apac. prefix). The plain model ID raises ValidationException here.
# Cross-region routing dispatches to us-east-1 / us-west-2 / ap-northeast-1.
#
# Fallback: anthropic.claude-3-sonnet-20240229-v1:0 is available directly in ap-south-1.
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0

# ---------------------------------------------------------------------------
# Lambda
# ---------------------------------------------------------------------------
LAMBDA_STAGE=local
# Set to "prod" (or your API Gateway stage name) when running on Lambda
